# MCP DataBridge Configuration
# Copy to .env and modify as needed

DATABRIDGE_DB_PATH=./data/titanic.db       # Path to SQLite database
DATABRIDGE_LOG_LEVEL=INFO                   # Logging level: DEBUG, INFO, WARNING, ERROR
DATABRIDGE_MAX_RESULTS=200                  # Max rows per query response
DATABRIDGE_TRANSPORT=stdio                  # Transport: stdio | streamable-http
DATABRIDGE_HOST=0.0.0.0                     # HTTP host (only for streamable-http)
DATABRIDGE_PORT=8000                        # HTTP port (only for streamable-http)
DATABRIDGE_QUERY_TIMEOUT=30                 # Query timeout in seconds
